# Kopieren nach ".env" und anpassen. ".env" selbst wird NICHT eingecheckt
# (siehe .gitignore) - Secrets gehören niemals ins Repository.

ENVIRONMENT=production
LOG_LEVEL=info

# Oeffentliche Basis-URL der App (ohne Slash am Ende). Wird fuer CORS, die
# Keycloak-Redirect-URIs (Realm-Import) und KC_HOSTNAME verwendet.
# Lokal: https://localhost
APP_PUBLIC_URL=https://pflege-finder.example.org

# Image-Tag des App-Containers. Wird vom Deploy-Workflow automatisch auf den
# Commit-SHA gesetzt (z.B. sha-1a2b3c4). Rollback = alten Tag eintragen und
# `docker compose up -d`. Lokal mit --build irrelevant.
IMAGE_TAG=latest

# Kommagetrennte Liste von Origins, die die API per CORS ansprechen dürfen.
# Für den Ein-Server-Betrieb (Nginx liefert Frontend + API vom selben
# Origin aus) reicht in der Regel die eigene Domain.
ALLOWED_ORIGINS=https://pflege-finder.example.org

# Signiert das Login-Session-Cookie. MUSS ein zufälliger, geheimer Wert mit
# mindestens 32 Zeichen sein - Platzhalter oder kurze Werte lehnt die App im
# Produktivbetrieb beim Start ab.
# Erzeugen mit: openssl rand -base64 32
SECRET_KEY=change-me

# --- Login-Pflicht ---
# true (Default/empfohlen): jede Seite verlangt einen gültigen Keycloak-
# Login. Erfordert vollständig konfiguriertes OIDC weiter unten - ohne das
# startet die App absichtlich NICHT (fail-fast statt fail-open).
# false: kein Login nötig - NUR für schnelle lokale UI-/Datenexploration
# ohne Keycloak, niemals im Produktivbetrieb.
AUTH_ENABLED=true

# --- Keycloak-Betrieb (docker compose --profile sso up -d) ---
# Admin-Login für die Keycloak-Konsole (https://<host>/idp/admin/).
# Starkes, zufälliges Passwort setzen, z.B.: openssl rand -base64 24
KEYCLOAK_ADMIN_PASSWORD=change-me
# Passwort der Keycloak-eigenen Postgres-DB (nur intern erreichbar).
KEYCLOAK_DB_PASSWORD=change-me
# Passwort der App-Postgres-DB (nur intern erreichbar).
APP_DB_PASSWORD=change-me
# Oeffentliche Keycloak-Basis-URL INKLUSIVE /idp (= APP_PUBLIC_URL + /idp).
KC_HOSTNAME=https://pflege-finder.example.org/idp
# "start" fuer den Produktivbetrieb (Default). Lokal ohne echtes Zertifikat
# ggf. "start-dev" (lockerere Hostname-Pruefung, kein Cache-Tuning).
KC_COMMAND=start

# --- SSO-Anbindung der App an Keycloak ---
# Reihenfolge beim erstmaligen Aufsetzen (siehe docs/ROADMAP.md, 1.1):
#   1. Nur Keycloak starten:  docker compose --profile sso up -d keycloak
#   2. Client-Secret kopieren: Admin-Konsole -> Clients -> pflege-finder
#      -> Credentials -> Client secret
#   3. Hier eintragen, dann die restlichen Container starten:
#      docker compose --profile sso up -d --build
# Realm/Client kommen aus keycloak/realm-export.json (Realm "hfh-pflege",
# Client "pflege-finder", Redirect-URIs aus APP_PUBLIC_URL). Issuer-URL
# entspricht dem Pfad, unter dem nginx Keycloak proxied (= KC_HOSTNAME +
# /realms/hfh-pflege). Platzhalter "change-me" gilt als NICHT konfiguriert.
OIDC_ISSUER=https://pflege-finder.example.org/idp/realms/hfh-pflege
OIDC_CLIENT_ID=pflege-finder
OIDC_CLIENT_SECRET=change-me

# Zusätzlich, NUR mit Docker Compose relevant: Server-zu-Server-Aufrufe
# (Token-Tausch, Userinfo) macht der App-Container selbst - "localhost" in
# OIDC_ISSUER wäre dabei der App-Container selbst, nicht Keycloak. Deshalb
# hier die direkte, interne Docker-Netzwerk-Adresse (Servicename "keycloak"
# aus docker-compose.yml). Für den Browser sichtbare URLs bleiben OIDC_ISSUER.
OIDC_ISSUER_INTERNAL=http://keycloak:8080/idp/realms/hfh-pflege
