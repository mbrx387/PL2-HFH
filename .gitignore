__pycache__/
*.pyc
# Echte Umgebungsdateien nie versionieren - nur die Vorlage .env.example.
# Die Deploy-Pipeline bricht zusaetzlich ab, falls doch eine eingecheckt wird.
.env
.env.*
*.env
!.env.example
.venv/
venv/
*.egg-info/
.DS_Store

# Selbstsignierte Dev-Zertifikate nicht versionieren
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt
# Lokale Monitoring-Zugangsdaten, nie committen.
nginx/htpasswd.monitoring

# Persoenliche Editor-Einstellungen
.vscode/

# certbot-Challenge-Dateien (Webroot), nur kurzzeitig auf dem Server
nginx/acme-challenge/*
!nginx/acme-challenge/.gitkeep
